generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoEstabelecimentoClinica {
  CLINICA
  LABORATORIO_ANALISES_CLINICAS
}

enum TipoPrecificacaoClinica {
  INDIVIDUAL
  CH
}

enum ModoPrecoProcedimento {
  FIXO
  CH
}

enum SexoBiologicoPaciente {
  MASCULINO
  FEMININO
  INTERSEXO
  NAO_INFORMADO
}

enum GeneroPaciente {
  HOMEM
  MULHER
  NAO_BINARIO
  OUTRO
  PREFERE_NAO_INFORMAR
}

enum MultiplicidadeProcedimento {
  UNICO
  QUANTIDADE
  DETALHADO
}

enum StatusAtendimento {
  EM_ANDAMENTO
  AGUARDANDO_PAGAMENTO
  PARCIALMENTE_PAGO
  CONCLUIDO
  CANCELADO
}

enum StatusOrcamento {
  ABERTO
  PARCIALMENTE_CONVERTIDO
  ENCERRADO
}

enum StatusGuia {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  PARCIALMENTE_PAGA
  PAGA
  ESTORNO_PENDENTE
  CANCELADA
}

enum StatusItemGuia {
  ATIVO
  CANCELADO
  REALIZADO
}

enum TipoAgendamento {
  HORARIO
  ORDEM_CHEGADA
}

enum FormaPagamento {
  PIX
  PIX_PARCELADO
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

enum StatusRepasse {
  DISPONIVEL
  SOLICITADO
  EM_ANALISE
  APROVADO
  PAGO
  RECUSADO
}

enum StatusRelatoProblema {
  ABERTO
  EM_ANALISE
  RESOLVIDO
}

enum OrigemRepasse {
  INTERNO
  PORTAL_PARCEIRO
}

enum FormaPagamentoRepasse {
  PIX
  TRANSFERENCIA
  BOLETO
  DINHEIRO
  OUTRO
}

enum TipoContaFinanceira {
  BANCO
  CARTEIRA_DIGITAL
  CAIXA
  OUTRO
}

enum TipoMovimentacaoConta {
  ENTRADA
  SAIDA
}

enum OrigemMovimentacaoConta {
  PAGAMENTO
  ESTORNO
  REPASSE
  AJUSTE
  DESPESA
  TRANSFERENCIA
  DEPOSITO
  RETIRADA_SOCIO
}

// V1.2: a parcela a receber nao representa pagamento confirmado.
enum StatusParcelaReceber {
  PENDENTE
  PARCIALMENTE_RECEBIDA
  RECEBIDA
  CANCELADA
}

enum StatusSessaoCaixa {
  ABERTA
  FECHADA
}

enum NaturezaTransferenciaFinanceira {
  ENTRE_CONTAS
  DEPOSITO
}

enum TipoRetiradaSocio {
  PRO_LABORE
  DISTRIBUICAO_LUCROS
  ADIANTAMENTO
  OUTRA
}

enum TipoDocumentoRepasse {
  COMPROVANTE_PAGAMENTO
  NOTA_FISCAL_SERVICO
}


enum StatusAssinaturaSistema {
  NAO_CONFIGURADA
  ATIVA
  EM_ATRASO
  SUSPENSA
  CANCELADA
  ISENTA
}

enum StatusFaturaSistema {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
}

enum PerfilUsuario {
  ATENDENTE
  GERENTE
  ADMINISTRADOR
  DESENVOLVEDOR
}

enum StatusRecibo {
  ATIVO
  PARCIALMENTE_ESTORNADO
  ESTORNADO
  CANCELADO
}

enum TipoVinculoFamiliar {
  PAI
  MAE
  FILHO
  FILHA
  IRMAO
  IRMA
  AVO
  AVO_FEMININO
  NETO
  NETA
  MARIDO
  ESPOSA
  COMPANHEIRO
  COMPANHEIRA
  RESPONSAVEL
  DEPENDENTE
  OUTRO
}

model Organizacao {
  regrasBonificacaoV3 RegraBonificacaoV3[]
  fechamentosBonificacaoV3 FechamentoBonificacaoV3[]
  eventosBonificacaoV3 EventoBonificacaoV3[]
  configuracoesLaudosV3 ConfiguracaoLaudoV3[] @relation("V3OrgConfiguracaoLaudo")
  regrasFinanceirasTerceirizacao RegraFinanceiraV3[] @relation("V3OrgRegraFinanceira")
  titulosFinanceirosTerceirizacao TituloFinanceiroV3[] @relation("V3OrgTituloFinanceiro")
  terceirizacaoEquipamentos TerceirizacaoEquipamento[] @relation("V3OrganizacaoEquipamento")
  terceirizacaoProducoes TerceirizacaoProducao[] @relation("V3OrganizacaoProducao")
  id            Int       @id @default(autoincrement())

  nomeFantasia  String
  razaoSocial   String?
  documento     String?   @unique
  telefone      String?
  whatsapp      String?
  email         String?
  endereco      String?

  // Parâmetros gerais usados para novos documentos.
  // Alterações aqui não modificam orçamentos ou vouchers já emitidos.
  validadeOrcamentoDiasPadrao       Int     @default(15)
  condicoesPagamentoOrcamentoPadrao String? @db.Text
  validadeGuiaMesesPadrao           Int     @default(6)

  // Parâmetros operacionais/financeiros da organização.
  // Os módulos financeiros consomem estas preferências sem alterar documentos já emitidos.
  formasPagamentoHabilitadas FormaPagamento[] @default([PIX, PIX_PARCELADO, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, BOLETO, TRANSFERENCIA, OUTRO])
  textoPadraoRecibo          String?          @db.Text
  textoPadraoEstorno         String?          @db.Text

  // Assinatura do Digna Conect. Nesta etapa os dados são somente consultados
  // pela organização; a administração ficará no futuro perfil DESENVOLVEDOR.
  planoSistema                    String?
  valorMensalidadeSistema         Decimal?                 @db.Decimal(10, 2)
  diaVencimentoMensalidadeSistema Int?
  statusAssinaturaSistema         StatusAssinaturaSistema  @default(NAO_CONFIGURADA)
  proximaCobrancaSistema          DateTime?

  ativo         Boolean   @default(true)

  usuarios      Usuario[]
  atendimentos  Atendimento[]
  orcamentos    Orcamento[]
  modelosOrcamento ModeloOrcamento[]
  guias         Guia[]
  recibos       Recibo[]
  estornos      Estorno[]
  serieRecibo   SerieRecibo?
  serieEstorno  SerieEstorno?
  faturasSistema FaturaSistema[]
  repasses       Repasse[]
  relatosProblema RelatoProblema[]
  pedidosMedicos PedidoMedico[]
  operadorasPagamento OperadoraPagamento[]
  contasFinanceiras      ContaFinanceira[]
  formasRecebimento      FormaRecebimento[]
  movimentacoesConta     MovimentacaoConta[]
  contasPadraoRepasse    ContaPadraoRepasse[]

  // V1.2 - controle financeiro operacional
  planosParcelamento     PlanoParcelamento[]
  sessoesCaixa           SessaoCaixa[]
  despesasFinanceiras    DespesaFinanceira[]
  transferencias         TransferenciaFinanceira[]
  retiradasSocio         RetiradaSocio[]
  auditoriasFinanceiras  AuditoriaFinanceira[]

  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
}


model FaturaSistema {
  id             Int                 @id @default(autoincrement())
  codigoPublico  String?             @unique

  organizacaoId  Int
  organizacao    Organizacao         @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  // Competência deve representar o mês de referência da cobrança.
  competencia    DateTime
  valor          Decimal             @db.Decimal(10, 2)
  vencimento     DateTime
  status         StatusFaturaSistema @default(ABERTA)
  pagoEm         DateTime?

  // Link seguro para a fatura/boleto/PDF, preenchido pela área do desenvolvedor.
  urlFatura      String?
  observacoes    String?             @db.Text

  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt

  @@index([organizacaoId])
  @@index([status])
  @@index([vencimento])
  @@index([competencia])
}

model Usuario {
  regrasBonificacaoV3 RegraBonificacaoV3[] @relation("V3BonusFuncionario")
  regrasBonificacaoCriadasV3 RegraBonificacaoV3[] @relation("V3BonusRegraAutor")
  itensBonificacaoV3 ItemBonificacaoV3[]
  eventosBonificacaoV3 EventoBonificacaoV3[]
  auditoriasTitulosV3 AuditoriaTituloV3[] @relation("V3AuditoriaTituloUsuario")
  regrasFinanceirasV3Criadas RegraFinanceiraV3[] @relation("V3RegraCriadaPor")
  titulosFinanceirosV3Criados TituloFinanceiroV3[] @relation("V3TituloCriadoPor")
  baixasFinanceirasV3Registradas BaixaFinanceiraV3[] @relation("V3BaixaRegistradaPor")
  baixasFinanceirasV3Estornadas BaixaFinanceiraV3[] @relation("V3BaixaEstornadaPor")
  eventosLaudoV3 TerceirizacaoEventoLaudo[] @relation("V3UsuarioEventosLaudo")
  terceirizacaoRetiradas TerceirizacaoUsoEquipamento[] @relation("V3RetiradoPor")
  terceirizacaoExamesRealizados TerceirizacaoExame[] @relation("V3ExameRealizadoPor")
  terceirizacaoProducoesCriadas TerceirizacaoProducao[] @relation("V3ProducaoCriadaPor")
  id              Int            @id @default(autoincrement())

  pedidosMedicosEnviados PedidoMedico[] @relation("PedidoMedicoEnviadoPor")
  codigoPublico   String?        @unique
  nome            String
  email           String?        @unique
  perfil          PerfilUsuario  @default(ATENDENTE)
  ativo           Boolean        @default(true)

  // Autenticação e controle de acesso
  senhaHash                   String?
  trocarSenhaNoProximoLogin   Boolean        @default(false)
  ultimoLoginEm               DateTime?
  usarPermissoesPersonalizadas Boolean       @default(false)
  permissoes                  String[]        @default([])

  // Treinamento por usuário
  tourGuiadoAtivo             Boolean         @default(false)
  modoAprendizAtivo           Boolean         @default(false)
  tourPuladoHojeData          String?

  organizacaoId   Int
  organizacao     Organizacao    @relation(fields: [organizacaoId], references: [id])
  sessoes         SessaoUsuario[]
  toursDiarios     TourPaginaUsuario[]

  atendimentosCriados Atendimento[] @relation("AtendimentoCriadoPor")
  orcamentosCriados    Orcamento[]    @relation("OrcamentoCriadoPor")
  modelosOrcamentoCriados ModeloOrcamento[] @relation("ModeloOrcamentoCriadoPor")
  historicosOrcamento     HistoricoOrcamento[] @relation("HistoricoOrcamentoUsuario")
  pacientesCriados     Paciente[]     @relation("PacienteCriadoPor")
  guiasGeradas        Guia[]        @relation("GuiaGeradaPor")
  guiasConfirmadas    Guia[]        @relation("GuiaConfirmadaPor")
  itensGuiaConfirmados ItemGuia[]  @relation("ItemGuiaConfirmadoPor")
  recibosEmitidos     Recibo[]      @relation("ReciboEmitidoPor")
  estornosEmitidos     Estorno[]     @relation("EstornoEmitidoPor")
  repassesSolicitados  Repasse[]     @relation("RepasseSolicitadoPor")
  repassesAprovados    Repasse[]     @relation("RepasseAprovadoPor")
  repassesRecusados    Repasse[]     @relation("RepasseRecusadoPor")
  repassesPagos        Repasse[]     @relation("RepassePagoPor")
  documentosRepasseEnviados     DocumentoRepasse[] @relation("DocumentoRepasseEnviadoPor")
  documentosRepasseDesativados  DocumentoRepasse[] @relation("DocumentoRepasseDesativadoPor")
  relatosProblema              RelatoProblema[]

  // V1.2 - atribuicao de responsabilidade / rastreabilidade
  contaCaixaPropria         ContaFinanceira[]          @relation("CaixaIndividualUsuario")
  caixasAbertos             SessaoCaixa[]               @relation("CaixaAbertoPor")
  caixasFechados            SessaoCaixa[]               @relation("CaixaFechadoPor")
  despesasLancadas          DespesaFinanceira[]         @relation("DespesaLancadaPor")
  transferenciasCriadas     TransferenciaFinanceira[]   @relation("TransferenciaCriadaPor")
  retiradasRegistradas      RetiradaSocio[]            @relation("RetiradaRegistradaPor")
  recebimentosRegistrados   Pagamento[]                @relation("PagamentoRegistradoPor")
  auditoriasFinanceiras     AuditoriaFinanceira[]      @relation("AuditoriaFinanceiraUsuario")

  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
}

model SessaoUsuario {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique
  usuarioId    Int
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm     DateTime
  ultimoUsoEm  DateTime  @default(now())
  criadoEm     DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

model TourPaginaUsuario {
  id           Int       @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dataChave    String
  pagina       String
  criadoEm     DateTime  @default(now())

  @@unique([usuarioId, dataChave, pagina])
  @@index([usuarioId, dataChave])
}

model Empresa {
  id                  Int        @id @default(autoincrement())
  nome                String
  documento           String?    @unique
  percentualBeneficio Decimal?   @db.Decimal(5, 2)
  ativo               Boolean    @default(true)

  pacientes           Paciente[]

  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt
}

model Paciente {
  terceirizacaoProducoes TerceirizacaoProducao[] @relation("V3PacienteProducao")
  id                   Int       @id @default(autoincrement())

  codigoPublico        String?   @unique
  nome                 String
  nomeSocial           String?
  cpf                  String?   @unique
  rg                   String?
  telefone             String?
  telefoneSecundario   String?
  email                String?
  dataNascimento       DateTime?
  nomeMae              String?

  sexoBiologico        SexoBiologicoPaciente @default(NAO_INFORMADO)
  genero               GeneroPaciente?
  generoDescricao      String?
  cep                  String?
  logradouro           String?
  numeroEndereco       String?
  complementoEndereco  String?
  bairro               String?
  cidade               String?
  uf                   String?

  // Responsável legal é exigido pela aplicação quando o paciente é menor.
  // Quando for a própria mãe, responsavelLegalEhMae = true evita duplicar os dados.
  responsavelLegalEhMae       Boolean @default(false)
  responsavelLegalNome        String?
  responsavelLegalCpf         String?
  responsavelLegalTelefone    String?
  responsavelLegalParentesco  String?

  criadoPorId          Int?
  criadoPor            Usuario? @relation("PacienteCriadoPor", fields: [criadoPorId], references: [id])

  empresaId            Int?
  empresa              Empresa? @relation(fields: [empresaId], references: [id])

  beneficioAtivo       Boolean   @default(false)

  atendimentos         Atendimento[]
  pedidosMedicos        PedidoMedico[]
  orcamentos           Orcamento[]
  importacoesLegadas    PacienteImportacaoLegada[]

  vinculosComoOrigem   VinculoFamiliar[] @relation("VinculoPacienteOrigem")
  vinculosComoDestino  VinculoFamiliar[] @relation("VinculoPacienteDestino")

  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
}

model PacienteImportacaoLegada {
  id             Int      @id @default(autoincrement())
  pacienteId     Int
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  sistema        String
  chaveExterna   String
  dadosOriginais Json
  criadoEm       DateTime @default(now())

  @@unique([sistema, chaveExterna])
  @@index([pacienteId])
}
model VinculoFamiliar {
  id                Int                 @id @default(autoincrement())

  pacienteOrigemId  Int
  pacienteOrigem    Paciente            @relation("VinculoPacienteOrigem", fields: [pacienteOrigemId], references: [id])

  pacienteDestinoId Int
  pacienteDestino   Paciente            @relation("VinculoPacienteDestino", fields: [pacienteDestinoId], references: [id])

  tipo              TipoVinculoFamiliar

  // Relações consanguíneas serão permanentes na aplicação.
  // Cônjuge/companheiro pode ser encerrado sem apagar o histórico.
  removivel         Boolean             @default(false)
  ativo             Boolean             @default(true)
  encerradoEm       DateTime?

  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt

  @@unique([pacienteOrigemId, pacienteDestinoId, tipo])
  @@index([pacienteOrigemId])
  @@index([pacienteDestinoId])
}

model Clinica {
  configuracoesLaudosV3 ConfiguracaoLaudoV3[] @relation("V3ClinicaConfiguracaoLaudo")
  regrasFinanceirasTerceirizacao RegraFinanceiraV3[] @relation("V3ClinicaRegraFinanceira")
  titulosFinanceirosTerceirizacao TituloFinanceiroV3[] @relation("V3ClinicaTituloFinanceiro")
  terceirizacaoProducoes TerceirizacaoProducao[] @relation("V3ClinicaProducao")
  id             Int           @id @default(autoincrement())

  nome           String
  razaoSocial    String?
  documento      String?       @unique
  telefone       String?
  whatsapp       String?
  email          String?

  tipoEstabelecimento TipoEstabelecimentoClinica @default(CLINICA)
  tipoPrecificacao    TipoPrecificacaoClinica    @default(INDIVIDUAL)
  valorChRepasse      Decimal?                    @db.Decimal(12, 4)
  valorChPaciente     Decimal?                    @db.Decimal(12, 4)

  // Campo legado mantido temporariamente para preservar os fluxos atuais.
  endereco       String?

  // Endereço fiscal
  cepFiscal          String?
  logradouroFiscal   String?
  numeroFiscal       String?
  complementoFiscal  String?
  bairroFiscal       String?
  cidadeFiscal       String?
  ufFiscal           String?

  // Responsável legal
  responsavelLegalNome      String?
  responsavelLegalCpf       String?
  responsavelLegalCargo     String?
  responsavelLegalTelefone  String?
  responsavelLegalEmail     String?

  // Responsável financeiro
  financeiroMesmoLegal           Boolean @default(false)
  responsavelFinanceiroNome      String?
  responsavelFinanceiroCpf       String?
  responsavelFinanceiroCargo     String?
  responsavelFinanceiroTelefone  String?
  responsavelFinanceiroEmail     String?

  observacoes    String?
  ativo          Boolean       @default(true)
  parceriaAgendamentos     Boolean @default(true)
  parceriaTerceirizacao  Boolean @default(false)

  unidades       UnidadeClinica[]
  guias          Guia[]
  itensOrcamento ItemOrcamento[]
  itensModeloOrcamento ItemModeloOrcamento[]
  precos         PrecoProcedimentoClinica[]
  repasses       Repasse[]

  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
}

model UnidadeClinica {
  laudosParaEntregaV3 TerceirizacaoExame[] @relation("V3UnidadeEntregaLaudo")
  terceirizacaoProducoes TerceirizacaoProducao[] @relation("V3UnidadeProducao")
  id             Int       @id @default(autoincrement())

  clinicaId      Int
  clinica        Clinica   @relation(fields: [clinicaId], references: [id])

  nome           String
  codigoPublico  String?   @unique

  // Ao marcar esta opção no cadastro, a aplicação copia o endereço fiscal.
  // Os campos ficam gravados na unidade e podem ser alterados depois.
  usaEnderecoFiscal Boolean @default(false)

  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?

  telefone       String?
  whatsapp       String?
  email          String?

  ativo          Boolean   @default(true)

  precosEspecificos PrecoProcedimentoUnidade[]
  guias            Guia[]
  itensOrcamento   ItemOrcamento[]
  itensModeloOrcamento ItemModeloOrcamento[]

  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@index([clinicaId])
}

model ProcedimentoReferencia {
  id                 Int            @id @default(autoincrement())
  codigoTuss         String         @unique
  nomeTuss           String
  quantidadeCh       Decimal?       @db.Decimal(12, 4)
  fonteCh            String?
  versaoReferencia   String?
  inicioVigencia     DateTime?
  fimVigencia        DateTime?
  ativo              Boolean        @default(true)

  procedimentos      Procedimento[]

  equivalenciasHistoricas ProcedimentoEquivalenciaHistorica[]
  criadoEm           DateTime       @default(now())
  atualizadoEm       DateTime       @updatedAt

  @@index([nomeTuss])
}

model ProcedimentoEquivalenciaHistorica {
  id                  Int                     @id @default(autoincrement())
  codigoTussHistorico String                  @unique
  nomeHistorico       String?

  referenciaAtualId   Int
  referenciaAtual     ProcedimentoReferencia @relation(fields: [referenciaAtualId], references: [id])

  fonte               String?
  observacao          String?
  ativo               Boolean                 @default(true)

  criadoEm            DateTime                @default(now())
  atualizadoEm        DateTime                @updatedAt

  @@index([referenciaAtualId])
  @@index([ativo])
}

model Procedimento {
  terceirizacaoExames TerceirizacaoExame[] @relation("V3ProcedimentoExame")
  id             Int           @id @default(autoincrement())
  nome           String
  categoria      String?
  preparo        String?
  aliases        String[]      @default([])

  multiplicidade MultiplicidadeProcedimento @default(UNICO)
  // Catálogo operacional Digna. A referência oficial fica separada em ProcedimentoReferencia.
  referenciaId   Int?
  referencia     ProcedimentoReferencia? @relation(fields: [referenciaId], references: [id])

  // Campos legados mantidos temporariamente para uma migração segura.
  // Novos vínculos devem usar referenciaId.
  codigoTuss     String?       @unique
  nomeTuss       String?
  quantidadeCh   Decimal?      @db.Decimal(12, 4)

  ativo          Boolean       @default(true)

  precos         PrecoProcedimentoClinica[]
  precosUnidade  PrecoProcedimentoUnidade[]
  itensGuia      ItemGuia[]
  itensOrcamento ItemOrcamento[]
  itensModeloOrcamento ItemModeloOrcamento[]

  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  @@index([referenciaId])
}

model PrecoProcedimentoClinica {
  id               Int           @id @default(autoincrement())

  clinicaId        Int
  clinica          Clinica       @relation(fields: [clinicaId], references: [id])

  procedimentoId   Int
  procedimento     Procedimento  @relation(fields: [procedimentoId], references: [id])

  valorPaciente    Decimal       @db.Decimal(10, 2)
  valorRepasse     Decimal       @db.Decimal(10, 2)
  modoPreco        ModoPrecoProcedimento @default(FIXO)

  ativo            Boolean       @default(true)

  criadoEm         DateTime      @default(now())
  atualizadoEm     DateTime      @updatedAt

  @@unique([clinicaId, procedimentoId])
}

model PrecoProcedimentoUnidade {
  id               Int            @id @default(autoincrement())

  unidadeClinicaId Int
  unidadeClinica   UnidadeClinica @relation(fields: [unidadeClinicaId], references: [id])

  procedimentoId   Int
  procedimento     Procedimento   @relation(fields: [procedimentoId], references: [id])

  // Exceção à tabela-base da clínica. Só existe quando esta unidade
  // possui valores diferentes da tabela-base da clínica.
  valorPaciente    Decimal        @db.Decimal(10, 2)
  valorRepasse     Decimal        @db.Decimal(10, 2)

  ativo            Boolean        @default(true)

  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  @@unique([unidadeClinicaId, procedimentoId])
  @@index([unidadeClinicaId])
  @@index([procedimentoId])
}

model Atendimento {
  id               Int               @id @default(autoincrement())

  codigoPublico    String?           @unique

  pacienteId       Int
  paciente         Paciente          @relation(fields: [pacienteId], references: [id])

  organizacaoId    Int?
  organizacao      Organizacao?      @relation(fields: [organizacaoId], references: [id])

  criadoPorId      Int?
  criadoPor        Usuario?          @relation("AtendimentoCriadoPor", fields: [criadoPorId], references: [id])

  status              StatusAtendimento @default(EM_ANDAMENTO)
  etapaAtual          Int               @default(1)

  // Cancelamento lógico do atendimento. O histórico nunca é apagado.
  canceladoEm         DateTime?
  motivoCancelamento  String?

  guias               Guia[]
  pedidosMedicos       PedidoMedico[]

  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
}

// V1.3: documento médico privado e opcional, disponível a qualquer momento.
// Os bytes ficam no PostgreSQL: são preservados pelo backup do banco.
model PedidoMedico {
  id             Int          @id @default(autoincrement())
  organizacaoId  Int
  organizacao    Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  pacienteId     Int
  paciente       Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  atendimentoId  Int
  atendimento    Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  nomeOriginal   String       @db.VarChar(180)
  mimeType       String       @db.VarChar(40)
  tamanhoBytes   Int
  sha256         String       @db.VarChar(64)
  conteudo       Bytes        @db.ByteA
  enviadoPorId   Int?
  enviadoPor     Usuario?     @relation("PedidoMedicoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  criadoEm       DateTime     @default(now())
  removidoEm     DateTime?
  removidoPorId  Int?
  @@index([organizacaoId, pacienteId, criadoEm])
  @@index([organizacaoId, atendimentoId, criadoEm])
}

model ModeloOrcamento {
  id              Int       @id @default(autoincrement())
  nome            String
  categoria       String?
  descricao       String?
  ativo           Boolean   @default(true)

  // Organização e produtividade dos modelos.
  favorito        Boolean   @default(false)
  totalUsos       Int       @default(0)
  ultimoUsoEm     DateTime?

  organizacaoId   Int
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id])

  criadoPorId     Int?
  criadoPor       Usuario? @relation("ModeloOrcamentoCriadoPor", fields: [criadoPorId], references: [id])

  itens           ItemModeloOrcamento[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  @@index([organizacaoId])
  @@index([ativo])
  @@index([favorito])
  @@index([totalUsos])
  @@index([nome])
}

model ItemModeloOrcamento {
  id                Int       @id @default(autoincrement())

  modeloId          Int
  modelo            ModeloOrcamento @relation(fields: [modeloId], references: [id])

  procedimentoId    Int
  procedimento      Procedimento @relation(fields: [procedimentoId], references: [id])

  quantidade        Int       @default(1)
  detalhamento      String?
  // Clínica/unidade são preferências opcionais. O preço nunca fica salvo no modelo.
  clinicaId         Int?
  clinica           Clinica? @relation(fields: [clinicaId], references: [id])

  unidadeClinicaId  Int?
  unidadeClinica    UnidadeClinica? @relation(fields: [unidadeClinicaId], references: [id])

  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  @@index([modeloId, procedimentoId])
  @@index([procedimentoId])
  @@index([clinicaId])
  @@index([unidadeClinicaId])
}

model Orcamento {
  id                Int              @id @default(autoincrement())

  codigoPublico     String?          @unique

  organizacaoId     Int?
  organizacao       Organizacao?     @relation(fields: [organizacaoId], references: [id])

  criadoPorId       Int?
  criadoPor         Usuario?         @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id])

  // O orçamento pode existir antes do cadastro completo do paciente.
  pacienteId        Int?
  paciente          Paciente?        @relation(fields: [pacienteId], references: [id])

  // Nome e telefone ficam gravados no orçamento para preservar o histórico
  // e permitir orçamento sem CPF/cadastro completo.
  nomePaciente      String
  telefonePaciente  String

  status            StatusOrcamento  @default(ABERTO)
  observacoes       String?

  // Validade comercial do orçamento. O status "vencido" é calculado
  // automaticamente pela aplicação sem apagar nem alterar o histórico.
  validadeDias      Int              @default(15)
  validadeAte       DateTime?
  condicoesPagamento String?

  itens             ItemOrcamento[]
  historico         HistoricoOrcamento[]

  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  @@index([organizacaoId])
  @@index([pacienteId])
  @@index([status])
  @@index([validadeAte])
}

model ItemOrcamento {
  id                Int             @id @default(autoincrement())

  orcamentoId       Int
  orcamento         Orcamento       @relation(fields: [orcamentoId], references: [id])

  procedimentoId    Int
  procedimento      Procedimento    @relation(fields: [procedimentoId], references: [id])

  quantidade        Int             @default(1)
  detalhamento      String?
  clinicaId         Int?
  clinica           Clinica?        @relation(fields: [clinicaId], references: [id])

  unidadeClinicaId  Int?
  unidadeClinica    UnidadeClinica? @relation(fields: [unidadeClinicaId], references: [id])

  // Valores congelados no momento em que o orçamento é salvo.
  valorPaciente     Decimal         @default(0) @db.Decimal(10, 2)
  valorRepasse      Decimal         @default(0) @db.Decimal(10, 2)

  // Quando convertido, aponta exatamente para o item de guia gerado.
  itemGuiaId        Int?            @unique
  itemGuia          ItemGuia?       @relation(fields: [itemGuiaId], references: [id])
  convertidoEm      DateTime?

  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  @@index([orcamentoId])
  @@index([procedimentoId])
  @@index([clinicaId])
  @@index([unidadeClinicaId])
}


model HistoricoOrcamento {
  id            Int        @id @default(autoincrement())

  orcamentoId   Int
  orcamento     Orcamento  @relation(fields: [orcamentoId], references: [id])

  usuarioId     Int?
  usuario       Usuario?   @relation("HistoricoOrcamentoUsuario", fields: [usuarioId], references: [id])

  acao          String
  descricao     String?

  criadoEm      DateTime   @default(now())

  @@index([orcamentoId])
  @@index([usuarioId])
  @@index([acao])
  @@index([criadoEm])
}

model Guia {
  id                   Int          @id @default(autoincrement())

  codigoPublico        String?      @unique

  atendimentoId        Int
  atendimento          Atendimento  @relation(fields: [atendimentoId], references: [id])

  clinicaId            Int
  clinica              Clinica      @relation(fields: [clinicaId], references: [id])

  // Unidade/local em que esta guia será atendida.
  // Pode ser nula para clínicas legadas que ainda não possuem unidades cadastradas.
  unidadeClinicaId     Int?
  unidadeClinica       UnidadeClinica? @relation(fields: [unidadeClinicaId], references: [id])

  organizacaoId        Int?
  organizacao          Organizacao? @relation(fields: [organizacaoId], references: [id])

  geradaPorId          Int?
  geradaPor            Usuario?     @relation("GuiaGeradaPor", fields: [geradaPorId], references: [id])

  confirmadaPorId      Int?
  confirmadaPor        Usuario?     @relation("GuiaConfirmadaPor", fields: [confirmadaPorId], references: [id])

  confirmadaEm         DateTime?
  realizadaEm          DateTime?

  status               StatusGuia   @default(RASCUNHO)

  subtotal             Decimal      @default(0) @db.Decimal(10, 2)
  desconto             Decimal      @default(0) @db.Decimal(10, 2)
  beneficio            Decimal      @default(0) @db.Decimal(10, 2)
  valorFinal           Decimal      @default(0) @db.Decimal(10, 2)

  emitidaEm            DateTime?
  validadeAte          DateTime?

  itens                 ItemGuia[]
  pagamentos            Pagamento[]
  estornos              Estorno[]
  repasses              RepasseItem[]
  recibos               Recibo[]
  planosParcelamento    PlanoParcelamento[]

  criadoEm              DateTime     @default(now())
  atualizadoEm          DateTime     @updatedAt

  @@index([unidadeClinicaId])
}

model ItemGuia {
  id                  Int               @id @default(autoincrement())

  guiaId              Int
  guia                Guia              @relation(fields: [guiaId], references: [id])

  procedimentoId      Int
  procedimento        Procedimento      @relation(fields: [procedimentoId], references: [id])

  quantidade          Int               @default(1)
  detalhamento        String?
  status              StatusItemGuia    @default(ATIVO)

  // Confirmação operacional por procedimento (independente da quitação do paciente).
  confirmadaEm        DateTime?
  realizadaEm         DateTime?
  confirmadaPorId     Int?
  confirmadaPor       Usuario?          @relation("ItemGuiaConfirmadoPor", fields: [confirmadaPorId], references: [id], onDelete: SetNull)
  repassesProcedimento RepasseItemProcedimento[]

  valorPaciente       Decimal           @db.Decimal(10, 2)
  valorRepasse        Decimal           @db.Decimal(10, 2)

  tipoAgendamento     TipoAgendamento?
  dataAgendamento     DateTime?
  horarioAgendamento  String?

  canceladoEm         DateTime?
  motivoCancelamento  String?

  itemOrcamento       ItemOrcamento?

  criadoEm            DateTime          @default(now())
  atualizadoEm        DateTime          @updatedAt

  @@index([confirmadaPorId])
  @@index([realizadaEm])
}

model OperadoraPagamento {
  id              Int              @id @default(autoincrement())

  organizacaoId   Int
  organizacao     Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  nome            String
  ativo           Boolean          @default(true)

  // Mantido para compatibilidade com a primeira versão das tarifas.
  tarifas         TarifaPagamento[]
  formasRecebimento FormaRecebimento[]
  pagamentos      Pagamento[]

  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @default(now()) @updatedAt

  @@unique([organizacaoId, nome])
  @@index([organizacaoId, ativo])
}

model TarifaPagamento {
  id              Int               @id @default(autoincrement())

  operadoraId     Int
  operadora       OperadoraPagamento @relation(fields: [operadoraId], references: [id], onDelete: Cascade)

  forma           FormaPagamento
  parcelas        Int               @default(1)
  percentual      Decimal           @default(0) @db.Decimal(7, 4)
  fixa            Decimal           @default(0) @db.Decimal(10, 2)
  ativo           Boolean           @default(true)

  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @default(now()) @updatedAt

  @@unique([operadoraId, forma, parcelas])
  @@index([forma, parcelas])
}

model ContaFinanceira {
  id              Int                 @id @default(autoincrement())

  organizacaoId   Int
  organizacao     Organizacao         @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  nome            String
  tipo            TipoContaFinanceira @default(BANCO)
  saldoInicial    Decimal             @default(0) @db.Decimal(12, 2)
  saldoInicialEm  DateTime?
  // V1.2: cada caixa fisico pertence a um unico usuario.
  // Contas bancarias nao possuem responsavelCaixaId.
  responsavelCaixaId Int?
  responsavelCaixa   Usuario? @relation("CaixaIndividualUsuario", fields: [responsavelCaixaId], references: [id], onDelete: Restrict)
  ativo           Boolean             @default(true)

  formasPadrao    FormaRecebimento[]  @relation("FormaRecebimentoContaPadrao")
  pagamentos      Pagamento[]         @relation("PagamentoContaFinanceira")
  repasses        Repasse[]           @relation("RepasseContaFinanceira")
  movimentacoes   MovimentacaoConta[]
  padroesRepasse  ContaPadraoRepasse[]

  // V1.2 - relacoes para o caixa, despesas e transferencias
  sessoesCaixa           SessaoCaixa[]
  despesasFinanceiras    DespesaFinanceira[]
  transferenciasOrigem   TransferenciaFinanceira[] @relation("TransferenciaContaOrigem")
  transferenciasDestino  TransferenciaFinanceira[] @relation("TransferenciaContaDestino")
  retiradasSocio         RetiradaSocio[]

  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @default(now()) @updatedAt

  @@unique([organizacaoId, nome])
  @@unique([organizacaoId, responsavelCaixaId])
  @@index([organizacaoId, ativo])
}

model FormaRecebimento {
  id              Int                 @id @default(autoincrement())

  organizacaoId   Int
  organizacao     Organizacao         @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  nome            String
  forma           FormaPagamento

  operadoraId     Int?
  operadora       OperadoraPagamento? @relation(fields: [operadoraId], references: [id], onDelete: SetNull)

  contaPadraoId   Int?
  contaPadrao     ContaFinanceira?     @relation("FormaRecebimentoContaPadrao", fields: [contaPadraoId], references: [id], onDelete: SetNull)

  ativo           Boolean             @default(true)

  // Parcelamento manual proprio, distinto do cartao de credito.
  permiteParcelamento   Boolean @default(false)
  baixaManualPorParcela Boolean @default(false)

  tarifas         TarifaFormaRecebimento[]
  pagamentos      Pagamento[]
  planosParcelamento PlanoParcelamento[]

  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @default(now()) @updatedAt

  @@unique([organizacaoId, nome])
  @@index([organizacaoId, forma, ativo])
  @@index([operadoraId])
  @@index([contaPadraoId])
}

model TarifaFormaRecebimento {
  id                    Int              @id @default(autoincrement())

  formaRecebimentoId    Int
  formaRecebimento      FormaRecebimento @relation(fields: [formaRecebimentoId], references: [id], onDelete: Cascade)

  parcelas              Int              @default(1)
  percentual            Decimal          @default(0) @db.Decimal(7, 4)
  fixa                  Decimal          @default(0) @db.Decimal(10, 2)
  ativo                 Boolean          @default(true)

  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @default(now()) @updatedAt

  @@unique([formaRecebimentoId, parcelas])
  @@index([parcelas])
}

model ContaPadraoRepasse {
  id                  Int                    @id @default(autoincrement())

  organizacaoId       Int
  organizacao         Organizacao            @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  forma               FormaPagamentoRepasse
  contaFinanceiraId   Int
  contaFinanceira     ContaFinanceira        @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)

  criadoEm            DateTime               @default(now())
  atualizadoEm        DateTime               @default(now()) @updatedAt

  @@unique([organizacaoId, forma])
  @@index([contaFinanceiraId])
}

model MovimentacaoConta {
  id                  Int                      @id @default(autoincrement())

  organizacaoId       Int
  organizacao         Organizacao              @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  contaFinanceiraId   Int
  contaFinanceira     ContaFinanceira          @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)

  tipo                TipoMovimentacaoConta
  origem              OrigemMovimentacaoConta
  valor               Decimal                  @db.Decimal(12, 2)
  descricao           String?
  dataMovimentacao    DateTime                  @default(now())

  pagamentoId         Int?                     @unique
  pagamento           Pagamento?               @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  estornoId           Int?                     @unique
  estorno             Estorno?                 @relation(fields: [estornoId], references: [id], onDelete: Cascade)

  repasseId           Int?                     @unique
  repasse             Repasse?                 @relation(fields: [repasseId], references: [id], onDelete: Cascade)

  // Operacoes V1.2 identificadas para a conciliacao por conta.
  despesaFinanceiraId Int?                    @unique
  despesaFinanceira   DespesaFinanceira?      @relation(fields: [despesaFinanceiraId], references: [id], onDelete: Restrict)
  transferenciaId     Int?
  transferencia       TransferenciaFinanceira? @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)
  retiradaSocioId     Int?                    @unique
  retiradaSocio       RetiradaSocio?          @relation(fields: [retiradaSocioId], references: [id], onDelete: Restrict)
  sessaoCaixaId       Int?
  sessaoCaixa         SessaoCaixa?            @relation(fields: [sessaoCaixaId], references: [id], onDelete: SetNull)

  criadoEm            DateTime                 @default(now())

  @@index([organizacaoId, dataMovimentacao])
  @@index([contaFinanceiraId, dataMovimentacao])
  @@index([tipo, origem])
  @@index([transferenciaId])
  @@index([sessaoCaixaId])
}

model Pagamento {
  id                      Int                 @id @default(autoincrement())

  guiaId                  Int
  guia                    Guia                @relation(fields: [guiaId], references: [id])

  operadoraId             Int?
  operadora               OperadoraPagamento? @relation(fields: [operadoraId], references: [id])

  formaRecebimentoId      Int?
  formaRecebimento        FormaRecebimento?   @relation(fields: [formaRecebimentoId], references: [id], onDelete: SetNull)

  contaFinanceiraId       Int?
  contaFinanceira         ContaFinanceira?     @relation("PagamentoContaFinanceira", fields: [contaFinanceiraId], references: [id], onDelete: SetNull)

  // Snapshot de roteamento e identificação no momento do recebimento.
  formaRecebimentoNome    String?
  operadoraNome           String?
  contaFinanceiraNome     String?
  contaPadraoIdSnapshot   Int?
  contaAlteradaManualmente Boolean            @default(false)

  valor                   Decimal             @db.Decimal(10, 2)
  forma                   FormaPagamento
  parcelas                Int                 @default(1)

  // Snapshot da tarifa aplicada no momento do pagamento.
  // Pagamentos legados permanecem nulos e são tratados como tarifa zero.
  taxaPercentualAplicada  Decimal?            @db.Decimal(7, 4)
  taxaFixaAplicada        Decimal?            @db.Decimal(10, 2)
  valorTarifa             Decimal?            @db.Decimal(10, 2)
  valorLiquido            Decimal?            @db.Decimal(10, 2)

  // Data efetiva na conta. Quando NULL no legado, relatorios usam criadoEm.
  dataRecebimento         DateTime?            @db.Date
  registradoPorId         Int?
  registradoPor           Usuario?             @relation("PagamentoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  // O recebimento parcial de uma parcela cria um Pagamento efetivo.
  parcelaReceberId        Int?
  parcelaReceber          ParcelaReceber?      @relation(fields: [parcelaReceberId], references: [id], onDelete: Restrict)

  observacao              String?

  recibos                 ReciboPagamento[]
  estornos                Estorno[]
  movimentacaoConta       MovimentacaoConta?

  criadoEm                DateTime            @default(now())

  @@index([operadoraId])
  @@index([formaRecebimentoId])
  @@index([contaFinanceiraId])
  @@index([forma, parcelas])
  @@index([dataRecebimento])
  @@index([parcelaReceberId])
}

model Estorno {
  id              Int              @id @default(autoincrement())

  codigoPublico   String?          @unique
  numero          Int?
  ano             Int?

  organizacaoId   Int?
  organizacao     Organizacao?     @relation(fields: [organizacaoId], references: [id])

  emitidoPorId    Int?
  emitidoPor      Usuario?         @relation("EstornoEmitidoPor", fields: [emitidoPorId], references: [id])

  guiaId          Int
  guia            Guia             @relation(fields: [guiaId], references: [id])

  pagamentoId     Int?
  pagamento       Pagamento?       @relation(fields: [pagamentoId], references: [id])

  valor           Decimal          @db.Decimal(10, 2)
  forma           FormaPagamento
  motivo          String?

  movimentacaoConta MovimentacaoConta?

  criadoEm        DateTime         @default(now())

  @@unique([organizacaoId, ano, numero])
}

model SerieEstorno {
  id              Int          @id @default(autoincrement())

  organizacaoId   Int          @unique
  organizacao     Organizacao  @relation(fields: [organizacaoId], references: [id])

  ultimoNumero    Int          @default(100000)

  atualizadoEm    DateTime     @updatedAt
}

model SerieRecibo {
  id              Int          @id @default(autoincrement())

  organizacaoId   Int          @unique
  organizacao     Organizacao  @relation(fields: [organizacaoId], references: [id])

  ultimoNumero    Int          @default(100000)

  atualizadoEm    DateTime     @updatedAt
}

model Recibo {
  id                    Int           @id @default(autoincrement())

  codigoPublico         String        @unique
  numero                Int
  ano                   Int

  organizacaoId         Int
  organizacao           Organizacao   @relation(fields: [organizacaoId], references: [id])

  guiaId                Int
  guia                   Guia          @relation(fields: [guiaId], references: [id])

  emitidoPorId          Int?
  emitidoPor            Usuario?       @relation("ReciboEmitidoPor", fields: [emitidoPorId], references: [id])

  status                StatusRecibo   @default(ATIVO)

  valorRecebido         Decimal        @db.Decimal(10, 2)
  valorEstornado        Decimal        @default(0) @db.Decimal(10, 2)

  emitidoEm             DateTime       @default(now())

  // Fotografia do documento no momento da emissão.
  nomePaciente          String
  cpfPaciente           String
  nomeClinica           String
  documentoClinica      String?
  nomeOrganizacao       String
  documentoOrganizacao  String?
  descricaoProcedimentos String
  observacao            String?

  pagamentos            ReciboPagamento[]

  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  @@unique([organizacaoId, ano, numero])
}

model ReciboPagamento {
  reciboId          Int
  recibo            Recibo      @relation(fields: [reciboId], references: [id], onDelete: Cascade)

  pagamentoId       Int         @unique
  pagamento         Pagamento   @relation(fields: [pagamentoId], references: [id])

  criadoEm          DateTime    @default(now())

  @@id([reciboId, pagamentoId])
}

model RelatoProblema {
  id              Int                  @id @default(autoincrement())

  organizacaoId   Int
  organizacao     Organizacao          @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  usuarioId       Int
  usuario         Usuario              @relation(fields: [usuarioId], references: [id])

  titulo          String
  descricao       String               @db.Text
  pagina          String?
  rota            String?
  navegador       String?
  screenshotMime  String?
  screenshot      Bytes?

  status          StatusRelatoProblema @default(ABERTO)

  criadoEm        DateTime             @default(now())
  atualizadoEm    DateTime             @updatedAt

  @@index([organizacaoId])
  @@index([usuarioId])
  @@index([status])
  @@index([criadoEm])
}

model Repasse {
  id                       Int             @id @default(autoincrement())
  codigoPublico            String?         @unique

  organizacaoId            Int?
  organizacao              Organizacao?    @relation(fields: [organizacaoId], references: [id])

  clinicaId                Int
  clinica                  Clinica         @relation(fields: [clinicaId], references: [id])

  status                   StatusRepasse   @default(SOLICITADO)
  origem                   OrigemRepasse   @default(INTERNO)

  valorTotal               Decimal         @default(0) @db.Decimal(10, 2)
  dataPagamentoSolicitada  DateTime?

  solicitadoPorId          Int?
  solicitadoPor            Usuario?        @relation("RepasseSolicitadoPor", fields: [solicitadoPorId], references: [id])

  aprovadoPorId            Int?
  aprovadoPor              Usuario?        @relation("RepasseAprovadoPor", fields: [aprovadoPorId], references: [id])

  recusadoPorId            Int?
  recusadoPor              Usuario?        @relation("RepasseRecusadoPor", fields: [recusadoPorId], references: [id])

  pagoPorId                Int?
  pagoPor                  Usuario?        @relation("RepassePagoPor", fields: [pagoPorId], references: [id])

  solicitadoEm             DateTime        @default(now())
  emAnaliseEm              DateTime?
  aprovadoEm               DateTime?
  recusadoEm               DateTime?
  pagoEm                   DateTime?
  dataPagamentoEfetivo     DateTime?
  formaPagamento           FormaPagamentoRepasse?

  contaFinanceiraId        Int?
  contaFinanceira          ContaFinanceira? @relation("RepasseContaFinanceira", fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  contaFinanceiraNome      String?
  contaPadraoIdSnapshot    Int?
  contaAlteradaManualmente Boolean          @default(false)

  observacaoPagamento      String?         @db.Text

  motivoRecusa             String?
  observacoes              String?         @db.Text

  itens                    RepasseItem[]
  documentos               DocumentoRepasse[]
  movimentacaoConta        MovimentacaoConta?

  criadoEm                 DateTime        @default(now())
  atualizadoEm             DateTime        @updatedAt

  @@index([organizacaoId])
  @@index([clinicaId])
  @@index([status])
  @@index([contaFinanceiraId])
  @@index([dataPagamentoSolicitada])
}

model DocumentoRepasse {
  id                Int                    @id @default(autoincrement())

  repasseId         Int
  repasse           Repasse                @relation(fields: [repasseId], references: [id], onDelete: Cascade)

  tipo              TipoDocumentoRepasse
  nomeOriginal      String
  mimeType          String
  tamanhoBytes      Int
  conteudo          Bytes
  ativo             Boolean                @default(true)

  enviadoPorId      Int?
  enviadoPor        Usuario?               @relation("DocumentoRepasseEnviadoPor", fields: [enviadoPorId], references: [id])

  desativadoEm      DateTime?
  desativadoPorId   Int?
  desativadoPor     Usuario?               @relation("DocumentoRepasseDesativadoPor", fields: [desativadoPorId], references: [id])

  criadoEm          DateTime               @default(now())

  @@index([repasseId])
  @@index([tipo])
  @@index([ativo])
}

model RepasseItem {
  id              Int          @id @default(autoincrement())

  repasseId       Int
  repasse         Repasse      @relation(fields: [repasseId], references: [id])

  guiaId          Int
  guia            Guia         @relation(fields: [guiaId], references: [id])

  valor           Decimal      @db.Decimal(10, 2)
  procedimentos   RepasseItemProcedimento[]

  criadoEm        DateTime     @default(now())

  @@unique([repasseId, guiaId])
}
// V1.2 Pacote 13: detalhamento dos procedimentos cobertos por um repasse.
// Repasses antigos continuam sem linhas nesta tabela e permanecem íntegros.
model RepasseItemProcedimento {
  id               Int          @id @default(autoincrement())
  repasseItemId    Int
  repasseItem      RepasseItem  @relation(fields: [repasseItemId], references: [id], onDelete: Restrict)
  itemGuiaId       Int
  itemGuia         ItemGuia     @relation(fields: [itemGuiaId], references: [id], onDelete: Restrict)
  valor            Decimal      @db.Decimal(10, 2)
  criadoEm         DateTime     @default(now())

  @@unique([repasseItemId, itemGuiaId])
  @@index([itemGuiaId])
}
// -----------------------------------------------------------------------------
// DIGNA CONECT V1.2 - FINANCEIRO
// Estrutura aditiva. Nenhum registro anterior precisa ser removido.
// -----------------------------------------------------------------------------

// Parcelar nao significa receber: plano de recebimento pendente.
model PlanoParcelamento {
  id                  Int               @id @default(autoincrement())
  organizacaoId       Int
  organizacao         Organizacao       @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  guiaId              Int
  guia                Guia              @relation(fields: [guiaId], references: [id], onDelete: Restrict)
  formaRecebimentoId  Int?
  formaRecebimento    FormaRecebimento? @relation(fields: [formaRecebimentoId], references: [id], onDelete: SetNull)
  forma               FormaPagamento
  descricaoForma      String?
  valorTotal          Decimal           @db.Decimal(12, 2)
  numeroParcelas      Int
  ativo               Boolean           @default(true)
  observacao          String?           @db.Text
  canceladoEm         DateTime?
  motivoCancelamento  String?
  parcelas            ParcelaReceber[]
  criadoEm            DateTime          @default(now())
  atualizadoEm        DateTime          @updatedAt

  @@index([organizacaoId, criadoEm])
  @@index([guiaId])
  @@index([forma, ativo])
}

model ParcelaReceber {
  id                  Int                  @id @default(autoincrement())
  planoParcelamentoId Int
  planoParcelamento   PlanoParcelamento    @relation(fields: [planoParcelamentoId], references: [id], onDelete: Restrict)
  numero              Int
  vencimento          DateTime             @db.Date
  valorPrevisto       Decimal              @db.Decimal(12, 2)
  status              StatusParcelaReceber @default(PENDENTE)
  observacao          String?
  pagamentos          Pagamento[]
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt

  // ATRASADA nao se persiste: calcular usando vencimento, saldo e data atual.
  // Valor recebido/saldo sao derivados dos pagamentos descontando estornos.
  @@unique([planoParcelamentoId, numero])
  @@index([vencimento, status])
}

// Uma sessao pertence a uma conta do tipo CAIXA (regra da API).
model SessaoCaixa {
  id                   Int               @id @default(autoincrement())
  organizacaoId        Int
  organizacao          Organizacao       @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  contaFinanceiraId    Int
  contaFinanceira      ContaFinanceira   @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  dataMovimento        DateTime          @db.Date
  status               StatusSessaoCaixa @default(ABERTA)
  saldoInicialInformado Decimal          @db.Decimal(12, 2)
  saldoFinalEsperado   Decimal?          @db.Decimal(12, 2)
  saldoFinalContado    Decimal?          @db.Decimal(12, 2)
  diferenca            Decimal?          @db.Decimal(12, 2)
  abertoPorId          Int
  abertoPor            Usuario           @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id], onDelete: Restrict)
  fechadoPorId         Int?
  fechadoPor           Usuario?          @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id], onDelete: SetNull)
  abertoEm             DateTime          @default(now())
  fechadoEm            DateTime?
  observacaoAbertura   String?
  observacaoFechamento String?
  movimentacoes        MovimentacaoConta[]
  criadoEm             DateTime          @default(now())
  atualizadoEm         DateTime          @updatedAt

  // Indice parcial para impedir dois caixas abertos na mesma conta: migration SQL.
  @@index([organizacaoId, dataMovimento])
  @@index([contaFinanceiraId, status])
}

model DespesaFinanceira {
  id                    Int              @id @default(autoincrement())
  organizacaoId         Int
  organizacao           Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  contaFinanceiraId     Int
  contaFinanceira       ContaFinanceira  @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  descricao             String
  categoria             String?
  valor                 Decimal          @db.Decimal(12, 2)
  dataPagamento         DateTime         @db.Date
  documentoReferencia   String?
  comprovanteReferencia String?
  registradoPorId       Int
  registradoPor         Usuario          @relation("DespesaLancadaPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  movimento             MovimentacaoConta?
  canceladaEm           DateTime?
  motivoCancelamento    String?
  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @updatedAt

  @@index([organizacaoId, dataPagamento])
  @@index([contaFinanceiraId, dataPagamento])
}

// Cada transferencia gera uma SAIDA e uma ENTRADA na mesma transacao.
model TransferenciaFinanceira {
  id                      Int                             @id @default(autoincrement())
  organizacaoId           Int
  organizacao             Organizacao                     @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  contaOrigemId           Int
  contaOrigem             ContaFinanceira                 @relation("TransferenciaContaOrigem", fields: [contaOrigemId], references: [id], onDelete: Restrict)
  contaDestinoId          Int
  contaDestino            ContaFinanceira                 @relation("TransferenciaContaDestino", fields: [contaDestinoId], references: [id], onDelete: Restrict)
  natureza                NaturezaTransferenciaFinanceira @default(ENTRE_CONTAS)
  valor                   Decimal                         @db.Decimal(12, 2)
  dataEfetiva             DateTime                        @db.Date
  descricao               String?
  comprovanteReferencia   String?
  registradoPorId         Int
  registradoPor           Usuario                        @relation("TransferenciaCriadaPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  movimentacoes           MovimentacaoConta[]
  canceladaEm             DateTime?
  criadoEm                DateTime                        @default(now())
  atualizadoEm            DateTime                        @updatedAt

  @@index([organizacaoId, dataEfetiva])
  @@index([contaOrigemId, dataEfetiva])
  @@index([contaDestinoId, dataEfetiva])
}

model RetiradaSocio {
  id                      Int             @id @default(autoincrement())
  organizacaoId           Int
  organizacao             Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  contaFinanceiraId       Int
  contaFinanceira         ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  socioNome               String
  tipo                    TipoRetiradaSocio
  competencia             DateTime?       @db.Date
  valor                   Decimal         @db.Decimal(12, 2)
  dataEfetiva             DateTime        @db.Date
  observacao              String?
  comprovanteReferencia   String?
  registradoPorId         Int
  registradoPor           Usuario         @relation("RetiradaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  movimento               MovimentacaoConta?
  canceladaEm             DateTime?
  criadoEm                DateTime        @default(now())
  atualizadoEm            DateTime        @updatedAt

  @@index([organizacaoId, dataEfetiva])
  @@index([contaFinanceiraId, dataEfetiva])
  @@index([tipo, competencia])
}

// Corrigir ou cancelar movimentos exige justificativa, autor e trilha imutavel.
model AuditoriaFinanceira {
  id            Int          @id @default(autoincrement())
  organizacaoId Int
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  usuarioId     Int?
  usuario       Usuario?     @relation("AuditoriaFinanceiraUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  entidade      String
  registroId    Int
  acao          String
  motivo        String?
  dadosAnteriores Json?
  dadosNovos    Json?
  criadoEm      DateTime     @default(now())

  @@index([organizacaoId, criadoEm])
  @@index([entidade, registroId])
}

// -----------------------------------------------------------------------------
// TERCEIRIZACAO V3.0 - entidades aditivas (sem modificar registros da V1)
// -----------------------------------------------------------------------------

enum TipoExameTerceirizacao {
  ECG
  EEG
  ESPIROMETRIA
  MAPA
  HOLTER
}

enum StatusExameTerceirizacao {
  REALIZADO
  ENVIADO_LAUDO
  LAUDO_RECEBIDO
  ENTREGUE
  CANCELADO
}

enum TipoEquipamentoTerceirizacao {
  MAPA
  HOLTER
  ECG
  EEG
  ESPIROMETRO
}

// Um lancamento agrupa varios exames da mesma pessoa no mesmo atendimento.
// O nome digitado e preservado; pacienteId so deve ser vinculado apos identificar
// a pessoa com seguranca. Nunca vincular homonimos automaticamente.
model TerceirizacaoProducao {
  id                   Int         @id @default(autoincrement())
  organizacaoId        Int
  organizacao          Organizacao @relation("V3OrganizacaoProducao", fields: [organizacaoId], references: [id])
  clinicaId            Int
  clinica              Clinica     @relation("V3ClinicaProducao", fields: [clinicaId], references: [id])
  unidadeClinicaId     Int?
  unidadeClinica       UnidadeClinica? @relation("V3UnidadeProducao", fields: [unidadeClinicaId], references: [id])
  pacienteId           Int?
  paciente             Paciente?   @relation("V3PacienteProducao", fields: [pacienteId], references: [id])
  nomePacienteDigitado String
  dataRealizacao       DateTime    @db.Date
  criadoPorId          Int
  criadoPor            Usuario     @relation("V3ProducaoCriadaPor", fields: [criadoPorId], references: [id])
  exames               TerceirizacaoExame[]
  criadoEm             DateTime    @default(now())
  atualizadoEm         DateTime    @updatedAt

  @@index([organizacaoId, dataRealizacao])
  @@index([clinicaId, dataRealizacao])
  @@index([pacienteId, dataRealizacao])
}

// Cada exame possui ciclo individual de laudo, valor, aparelho e bonificacao.
model TerceirizacaoExame {
  classificacaoBonificacaoV3 ClassificacaoBonificacaoV3 @default(NAO_CONFERIDO)
  itemBonificacaoV3 ItemBonificacaoV3?
  eventosBonificacaoV3 EventoBonificacaoV3[]
  titulosFinanceirosV3 TituloFinanceiroV3[] @relation("V3TitulosDoExame")
  laudoTelemedicina String?
  laudoUnidadeEntregaId Int?
  laudoUnidadeEntrega UnidadeClinica? @relation("V3UnidadeEntregaLaudo", fields: [laudoUnidadeEntregaId], references: [id])
  laudoPrevisaoOriginal DateTime? @db.Date
  laudoPrevisaoEntrega DateTime? @db.Date
  laudoConvenio String?
  laudoCategoriaAtendimento String?
  laudoFormaPagamento String?
  laudoValorBaseReal Decimal? @db.Decimal(14, 2)
  financeiroPendenciaV3 String?
  laudoNascimento DateTime? @db.Date
  laudoDocumento String?
  laudoObservacoes String?
  laudoEnviadoEm DateTime?
  laudoRecebidoEm DateTime?
  laudoEntregueEm DateTime?
  laudoMeioEntrega String?
  laudoReferenciaEntrega String?
  eventosLaudo TerceirizacaoEventoLaudo[] @relation("V3EventosDoExame")
  id                Int        @id @default(autoincrement())
  codigoInterno     String     @unique @default(cuid())
  producaoId        Int
  producao          TerceirizacaoProducao @relation(fields: [producaoId], references: [id])
  tipoExame         TipoExameTerceirizacao
  procedimentoId    Int?
  procedimento      Procedimento? @relation("V3ProcedimentoExame", fields: [procedimentoId], references: [id])
  executadoPorId    Int
  executadoPor      Usuario    @relation("V3ExameRealizadoPor", fields: [executadoPorId], references: [id])
  status            StatusExameTerceirizacao @default(REALIZADO)
  usoEquipamento    TerceirizacaoUsoEquipamento?
  criadoEm          DateTime   @default(now())
  atualizadoEm      DateTime   @updatedAt

  @@index([producaoId])
  @@index([tipoExame, status])
  @@index([executadoPorId, status])
}

model TerceirizacaoEquipamento {
  id                Int        @id @default(autoincrement())
  organizacaoId     Int
  organizacao       Organizacao @relation("V3OrganizacaoEquipamento", fields: [organizacaoId], references: [id])
  codigo            String
  tipo              TipoEquipamentoTerceirizacao
  ativo             Boolean    @default(true)
  usos              TerceirizacaoUsoEquipamento[]
  criadoEm          DateTime   @default(now())
  atualizadoEm      DateTime   @updatedAt

  @@unique([organizacaoId, codigo])
  @@index([organizacaoId, tipo, ativo])
}

// Um exame MAPA/Holter usa um aparelho ate a retirada e o descarregamento.
// A API deve impedir transacionalmente nova alocacao enquanto descarregadoEm
// estiver nulo, e registrar quem confirmou a retirada.
model TerceirizacaoUsoEquipamento {
  id                Int        @id @default(autoincrement())
  exameId           Int        @unique
  exame             TerceirizacaoExame @relation(fields: [exameId], references: [id])
  equipamentoId     Int
  equipamento       TerceirizacaoEquipamento @relation(fields: [equipamentoId], references: [id])
  instaladoEm       DateTime
  retiradaPrevista  DateTime?  @db.Date
  retiradoEm        DateTime?
  retiradoPorId     Int?
  retiradoPor       Usuario?   @relation("V3RetiradoPor", fields: [retiradoPorId], references: [id])
  descarregadoEm    DateTime?
  criadoEm          DateTime   @default(now())
  atualizadoEm      DateTime   @updatedAt

  @@index([equipamentoId, descarregadoEm])
  @@index([retiradaPrevista, retiradoEm])
}

// Historico de acoes na esteira de laudos, separado do financeiro V1.
model TerceirizacaoEventoLaudo {
  id Int @id @default(autoincrement())
  exameId Int
  exame TerceirizacaoExame @relation("V3EventosDoExame", fields: [exameId], references: [id])
  usuarioId Int
  usuario Usuario @relation("V3UsuarioEventosLaudo", fields: [usuarioId], references: [id])
  acao String
  detalhes String?
  ocorridoEm DateTime @default(now())

  @@index([exameId, ocorridoEm])
  @@index([usuarioId, ocorridoEm])
}

// -----------------------------------------------------------------------------
// FINANCEIRO DA TERCEIRIZACAO V3 — independente de caixa, guias e repasses da V1.
// A competencia e sempre derivada de exame.producao.dataRealizacao (@db.Date).
// Valores aplicados aos titulos sao snapshots e nao mudam quando regras mudarem.
// Nenhum exame antigo recebe titulo financeiro automaticamente nesta migracao.
// -----------------------------------------------------------------------------

enum MetodoCalculoFinanceiroV3 {
  FIXO
  PERCENTUAL
}

enum NaturezaTituloFinanceiroV3 {
  A_RECEBER
  A_PAGAR
}

// Vigencia e segmentacao permitem AdconMed por plano/sem plano e
// CLMED por modalidade/convênio. Evitar sobreposicao de regras na API.
model RegraFinanceiraV3 {
  id                  Int                           @id @default(autoincrement())
  organizacaoId       Int
  organizacao         Organizacao                   @relation("V3OrgRegraFinanceira", fields: [organizacaoId], references: [id])
  clinicaId           Int
  clinica             Clinica                       @relation("V3ClinicaRegraFinanceira", fields: [clinicaId], references: [id])
  tipoExame           TipoExameTerceirizacao
  convenio            String                        @default("")
  categoriaAtendimento String                       @default("")
  metodo              MetodoCalculoFinanceiroV3
  valorFixo           Decimal?                      @db.Decimal(14, 2)
  percentual          Decimal?                      @db.Decimal(7, 4)
  valorBaseReferencia Decimal?                      @db.Decimal(14, 2) // legado: somente informativo
  valorCobradoContratado Decimal?                    @db.Decimal(14, 2) // preco contratual para calculo percentual automatico
  inicioVigencia      DateTime                      @db.Date
  fimVigencia         DateTime?                     @db.Date
  ativo               Boolean                       @default(true)
  observacoes         String?                       @db.Text
  criadoPorId         Int
  criadoPor           Usuario                       @relation("V3RegraCriadaPor", fields: [criadoPorId], references: [id])
  titulos             TituloFinanceiroV3[]
  criadoEm            DateTime                      @default(now())
  atualizadoEm        DateTime                      @updatedAt

  @@index([organizacaoId, clinicaId, tipoExame, ativo])
  @@index([clinicaId, inicioVigencia, fimVigencia])
}

// Titulo por exame/natureza. A API deve conferir pertencimento do exame,
// clinica e organizacao, alem das permissoes V3, antes de criar ou modificar.
model TituloFinanceiroV3 {
  id                  Int                           @id @default(autoincrement())
  organizacaoId       Int
  organizacao         Organizacao                   @relation("V3OrgTituloFinanceiro", fields: [organizacaoId], references: [id])
  clinicaId           Int
  clinica             Clinica                       @relation("V3ClinicaTituloFinanceiro", fields: [clinicaId], references: [id])
  exameId             Int
  exame               TerceirizacaoExame            @relation("V3TitulosDoExame", fields: [exameId], references: [id])
  regraId             Int?
  regra               RegraFinanceiraV3?            @relation(fields: [regraId], references: [id])
  natureza            NaturezaTituloFinanceiroV3    @default(A_RECEBER)
  convenio            String                        @default("")
  categoriaAtendimento String                       @default("")
  formaPagamentoOrigem String?
  valorBaseReferencia Decimal?                      @db.Decimal(14, 2)
  percentualAplicado  Decimal?                      @db.Decimal(7, 4)
  valorDevido         Decimal                       @db.Decimal(14, 2)
  observacoes         String?                       @db.Text
  canceladoEm         DateTime?
  motivoCancelamento  String?                       @db.Text
  criadoPorId         Int
  criadoPor           Usuario                       @relation("V3TituloCriadoPor", fields: [criadoPorId], references: [id])
  parcelas            ParcelaFinanceiraV3[]
  auditorias          AuditoriaTituloV3[] @relation("V3AuditoriasDoTitulo")
  dataCompetencia     DateTime? @db.Date // data real de realizacao; titulos legados podem permanecer null
  criadoEm            DateTime                      @default(now())
  atualizadoEm        DateTime                      @updatedAt

  @@unique([exameId, natureza])
  @@index([organizacaoId, clinicaId, natureza])
  @@index([regraId])
}

// Parcelas previstas: vencimento nao e data efetiva do recebimento.
model ParcelaFinanceiraV3 {
  id                  Int                           @id @default(autoincrement())
  tituloId            Int
  titulo              TituloFinanceiroV3            @relation(fields: [tituloId], references: [id])
  numero              Int
  vencimento          DateTime                      @db.Date
  valorPrevisto       Decimal                       @db.Decimal(14, 2)
  canceladaEm         DateTime?
  baixas              BaixaFinanceiraV3[]
  criadoEm            DateTime                      @default(now())
  atualizadoEm        DateTime                      @updatedAt

  @@unique([tituloId, numero])
  @@index([vencimento])
}

// Baixas parciais. Saldo = soma parcelas ativas - soma baixas nao estornadas.
// Nao apagar historico: estorno sempre registra data, usuario e justificativa.
model BaixaFinanceiraV3 {
  id                  Int                           @id @default(autoincrement())
  parcelaId           Int
  parcela             ParcelaFinanceiraV3           @relation(fields: [parcelaId], references: [id])
  valor               Decimal                       @db.Decimal(14, 2)
  dataEfetiva         DateTime                      @db.Date
  formaPagamento      String?
  referencia          String?
  observacoes         String?                       @db.Text
  registradoPorId     Int
  registradoPor        Usuario                       @relation("V3BaixaRegistradaPor", fields: [registradoPorId], references: [id])
  estornadoEm         DateTime?
  estornadoPorId      Int?
  estornadoPor        Usuario?                      @relation("V3BaixaEstornadaPor", fields: [estornadoPorId], references: [id])
  motivoEstorno       String?                       @db.Text
  criadoEm            DateTime                      @default(now())

  @@index([parcelaId, dataEfetiva])
  @@index([dataEfetiva, estornadoEm])
}

// Configuracao operacional e contratual por clinica e modalidade V3.
// Dia inicial em REALIZACAO ou ENVIO; dias corridos.
enum MarcoPrazoLaudoV3 {
  REALIZACAO
  ENVIO
}

model ConfiguracaoLaudoV3 {
  id                 Int                     @id @default(autoincrement())
  organizacaoId      Int
  organizacao        Organizacao             @relation("V3OrgConfiguracaoLaudo", fields: [organizacaoId], references: [id])
  clinicaId          Int
  clinica            Clinica                 @relation("V3ClinicaConfiguracaoLaudo", fields: [clinicaId], references: [id])
  tipoExame          TipoExameTerceirizacao
  prazoDias          Int
  marcoPrazo         MarcoPrazoLaudoV3       @default(REALIZACAO)
  convenios          String[]                @default([])
  formasPagamento    String[]                @default([])
  diasVencimento     Int                     @default(0)
  atualizadoEm       DateTime                @updatedAt
  criadoEm           DateTime                @default(now())

  @@unique([organizacaoId, clinicaId, tipoExame])
  @@index([clinicaId, tipoExame])
}

// Historico imutavel de alteracoes excepcionais de titulo por administrador.
model AuditoriaTituloV3 {
  id             Int                @id @default(autoincrement())
  tituloId       Int
  titulo         TituloFinanceiroV3 @relation("V3AuditoriasDoTitulo", fields: [tituloId], references: [id])
  usuarioId      Int
  usuario        Usuario            @relation("V3AuditoriaTituloUsuario", fields: [usuarioId], references: [id])
  motivo         String             @db.Text
  dadosAnteriores Json
  dadosNovos     Json
  criadoEm       DateTime           @default(now())

  @@index([tituloId, criadoEm])
}

// V3 - Bonificacoes independentes dos repasses das clinicas.
enum ClassificacaoBonificacaoV3 {
  NAO_CONFERIDO
  ORIGINAL
  REPETICAO
}

enum SituacaoFechamentoBonificacaoV3 {
  FECHADO
  APROVADO
  PAGO
  REABERTO
}

model RegraBonificacaoV3 {
  id Int @id @default(autoincrement())
  organizacaoId Int
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  funcionarioId Int
  funcionario Usuario @relation("V3BonusFuncionario", fields: [funcionarioId], references: [id])
  tipoExame TipoExameTerceirizacao
  valor Decimal @db.Decimal(14, 2)
  inicioVigencia DateTime @db.Date
  criadoPorId Int
  criadoPor Usuario @relation("V3BonusRegraAutor", fields: [criadoPorId], references: [id])
  criadoEm DateTime @default(now())
  itens ItemBonificacaoV3[]
  @@unique([organizacaoId, funcionarioId, tipoExame, inicioVigencia], map: "RegraBonificacaoV3_org_func_tipo_inicio_key")
  @@index([organizacaoId, funcionarioId, tipoExame])
}

model FechamentoBonificacaoV3 {
  id Int @id @default(autoincrement())
  organizacaoId Int
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  competencia String @db.VarChar(7)
  situacao SituacaoFechamentoBonificacaoV3 @default(FECHADO)
  revisao Int @default(1)
  vencimento DateTime @db.Date
  feriadosLocais String[] @default([])
  fechadoEm DateTime @default(now())
  aprovadoEm DateTime?
  pagoEm DateTime? @db.Date
  itens ItemBonificacaoV3[]
  eventos EventoBonificacaoV3[]
  @@unique([organizacaoId, competencia])
}

model ItemBonificacaoV3 {
  id Int @id @default(autoincrement())
  fechamentoId Int
  fechamento FechamentoBonificacaoV3 @relation(fields: [fechamentoId], references: [id])
  exameId Int @unique
  exame TerceirizacaoExame @relation(fields: [exameId], references: [id])
  funcionarioId Int
  funcionario Usuario @relation(fields: [funcionarioId], references: [id])
  regraId Int
  regra RegraBonificacaoV3 @relation(fields: [regraId], references: [id])
  tipoExame TipoExameTerceirizacao
  valor Decimal @db.Decimal(14, 2)
  concluidoEm DateTime
  @@index([fechamentoId, funcionarioId])
}

model EventoBonificacaoV3 {
  id Int @id @default(autoincrement())
  organizacaoId Int
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  fechamentoId Int?
  fechamento FechamentoBonificacaoV3? @relation(fields: [fechamentoId], references: [id], onDelete: Restrict)
  exameId Int?
  exame TerceirizacaoExame? @relation(fields: [exameId], references: [id], onDelete: Restrict)
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  acao String
  motivo String
  dados Json?
  criadoEm DateTime @default(now())
  @@index([organizacaoId, criadoEm])
  @@index([fechamentoId, criadoEm])
  @@index([exameId, criadoEm])
}
